# OUI Database - Common Entries
# Format: HHHHHHH=Organization Name
# OUI is 24-bit hex value (6 hex digits)

# Special / Reserved
000000=Encapsulated Ethernet (RFC 1042)
0080C2=IEEE 802.1 Committee
01000C=Cisco CDP/VTP/UDLD
01005E=IPv4 Multicast
0180C2=IEEE 802.1 Spanning Tree
333300=IPv6 Multicast

